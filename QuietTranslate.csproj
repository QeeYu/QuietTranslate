<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuietTranslate.ico</ApplicationIcon>
    <StartupObject>QuietTranslate.App</StartupObject>
    <AssemblyName>QuietTranslate</AssemblyName>
    <Version>1.6.0</Version>
    <FileVersion>1.6.0.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <DefaultItemExcludes>$(DefaultItemExcludes);work\**;artifacts\**;local-ocr\**;tests\**;dist\**;validation\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets\*.ico" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
