<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
    <ApplicationIcon>../Assets/QuietTranslate.ico</ApplicationIcon>
    <StartupObject>QuietTranslate.TestHost</StartupObject>
    <AssemblyName>QuietTranslate.Tests</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the production sources unchanged, alongside partial App desktop fixtures. -->
    <Compile Include="*.cs;../App*.cs;../UI/**/*.cs;../Translation/**/*.cs;../OCR/**/*.cs;../Platform/**/*.cs;../Configuration/**/*.cs;../Speech/**/*.cs" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <Resource Include="../Assets/*.ico" Link="Assets/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
